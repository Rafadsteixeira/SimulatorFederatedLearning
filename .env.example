# Copie este arquivo como .env e informe suas proprias chaves localmente.
# O .env nunca deve ser versionado.

# --- Credenciais (preencha apenas a do provedor usado) ---
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# --- Criacao do agente Agno ---
# O modelo e montado como "<AGENT_PROVIDER>:<AGENT_MODEL_ID>".
# Quando definidos, AGENT_PROVIDER e AGENT_MODEL_ID tem precedencia sobre
# agent_provider e agent_model_id do arquivo de configuracao JSON.
# Exemplos:
#   AGENT_PROVIDER=groq       AGENT_MODEL_ID=openai/gpt-oss-120b
#   AGENT_PROVIDER=anthropic  AGENT_MODEL_ID=claude-opus-5-5
AGENT_PROVIDER=
AGENT_MODEL_ID=

# Nome do agente (aparece nos logs do Agno e na auditoria).
AGENT_NAME=fl-round-policy

# Criterio de decisao do agente. As regras de protocolo (responder pelo
# schema, uma acao por cliente, sem pesos numericos) sao fixas e sempre
# enviadas; este texto substitui apenas o criterio padrao abaixo.
AGENT_INSTRUCTIONS="Priorize qualidade de validacao, deadline, diversidade de dados e equidade."

# Depuracao do Agno (AGENT_DEBUG_LEVEL: 1 ou 2).
AGENT_DEBUG=false
AGENT_DEBUG_LEVEL=1

# Mantenha false: a resposta deve ser JSON puro para passar na validacao.
AGENT_MARKDOWN=false

# true: JSON pedido via prompt (funciona em qualquer provedor).
# false: usa saida estruturada nativa quando o modelo suporta (ex.: Claude).
AGENT_USE_JSON_MODE=true
